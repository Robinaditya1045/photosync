<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="home.photosync">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets us check Syncthing-Fork is installed and open it (Android 11+ package visibility). -->
    <queries>
        <package android:name="com.github.catfriend1.syncthingfork" />
    </queries>

    <application
        android:label="Photo Sync"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoSync"
        android:networkSecurityConfig="@xml/network_security">

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".SyncWidget"
            android:label="Photo Sync"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
