<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget. Texts below are what the widget picker preview shows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="@dimen/ring"
            android:layout_height="@dimen/ring">

            <ImageView
                android:id="@+id/ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ring_preview" />

            <TextView
                android:id="@+id/ring_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="✓"
                android:textColor="@color/green"
                android:textSize="14sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="All photos on Pixel"
                android:textColor="@color/text1"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="4,332 files synced"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/dot"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:src="@drawable/dot"
                    android:tint="@color/green" />

                <TextView
                    android:id="@+id/meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Pixel connected"
                    android:textColor="@color/text3"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/more"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top"
            android:layout_marginTop="-6dp"
            android:layout_marginEnd="-8dp"
            android:contentDescription="Settings"
            android:padding="7dp"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- Per-folder rows: shown only when the widget is tall enough -->
    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="6dp"
            android:scaleType="fitXY"
            android:src="@color/border" />

        <LinearLayout android:id="@+id/row1" style="@style/WidgetRow">
            <TextView android:id="@+id/row1_name" style="@style/WidgetRowName" />
            <TextView android:id="@+id/row1_value" style="@style/WidgetRowValue" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row2" style="@style/WidgetRow">
            <TextView android:id="@+id/row2_name" style="@style/WidgetRowName" />
            <TextView android:id="@+id/row2_value" style="@style/WidgetRowValue" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row3" style="@style/WidgetRow">
            <TextView android:id="@+id/row3_name" style="@style/WidgetRowName" />
            <TextView android:id="@+id/row3_value" style="@style/WidgetRowValue" />
        </LinearLayout>

        <LinearLayout android:id="@+id/row4" style="@style/WidgetRow">
            <TextView android:id="@+id/row4_name" style="@style/WidgetRowName" />
            <TextView android:id="@+id/row4_value" style="@style/WidgetRowValue" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pushes the switch to the bottom when the widget is taller than its content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="12dp" />

    <!-- Auto / On / Off segmented switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/seg_track"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView android:id="@+id/seg_auto" style="@style/WidgetSeg"
            android:background="@drawable/seg_selected"
            android:text="Auto"
            android:textColor="@color/text1" />

        <TextView android:id="@+id/seg_on" style="@style/WidgetSeg"
            android:text="On" />

        <TextView android:id="@+id/seg_off" style="@style/WidgetSeg"
            android:text="Off" />
    </LinearLayout>
</LinearLayout>
